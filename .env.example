# Chave da API do provedor de LLM (OpenAI). Deixe em branco para usar apenas parser Python determinístico.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Diretórios padrão
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output

# Total de horas estimadas do projeto (regra de negócio)
HORAS_ESTIMADAS_TOTAIS=1000
